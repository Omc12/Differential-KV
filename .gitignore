# Byte-compiled / optimized / DLL files
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Unit test / coverage reports
.pytest_cache/
.tox/
.coverage
.coverage.*
.cache
*.log

# Telemetry and PyTorch Profiler trace files (huge JSONs)
*profiler_trace.json
*.pt.trace.json
*raw_telemetry.json
*raw_nvidia_smi*.log
*.jsonl
*.pt
*.pth
*.bin
*.safetensors

# Exclude all JSON trace/profiler files in any archive, telemetry, or results folder
**/archive/**/*.json
**/telemetry/**/*.json
**/results/**/*.json

# Ignore the massive synthetic systems archive completely
archive/ARCHIVED_SYNTHETIC_SYSTEMS/

# Build directories & package artifacts
**/build/
build/
dist/
*.egg-info/
.DS_Store
**/.DS_Store

# Compiled native extensions & object files — build per-platform, never commit.
# The one-time untrack of pre-rule artifacts (diffkv_core.cpython-*-darwin.so,
# build/*.o, *.metallib) was completed 2026-07-06; see BUILD.md §6.
*.so
*.dylib
*.o
*.obj
*.metallib

# GGUF models
*.gguf
**/qwen2.5-0.5b-instruct.gguf

# Dev scratch — throwaway scripts/profilers, not part of the shipped package.
# (archive/**/scratch is intentionally retained as a historical record.)
/scratch/
/ACTIVE_RUNTIME/scratch/

# External benchmark clones & datasets
LongBench/
RULER/

# Local virtual environment & IDE settings
dkv_venv/
.claude/
.vscode/

# LaTeX auxiliary build files & compiled manuscript packages
*.aux
*.bbl
*.blg
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
paper/*.pdf
paper/**/*.pdf
paper/*.docx
paper/**/*.docx
paper/*.zip
paper/**/*.zip
paper/submission_package/
paper/submission_documents/
paper/sections_ieee/
paper/*_ieee*
paper/*_IEEE*
paper/ieee_*
paper/IEEEtran*
paper/supplementary*
paper/xr.sty

# Temporary evaluation outputs in repository root
dkv_*_verified.json

# Post-paper engineering report
things_after_paper.md

# Ignore models directory and benchmark execution artifacts
models/
benchmarks/results/
benchmarks/results_*/
benchmarks/*.sh
benchmarks/bench_rope_tradeoff.py
docs/turboquant_dkv_hybrid_roadmap.md

# Paper results are evidence, not scratch: a table nobody can trace back to the
# rows that produced it is not reproducible. The blanket *.jsonl above would
# otherwise silently drop every benchmark result under paper/results/.
!paper/results/**/*.jsonl
!paper/results/**/*.meta.json

# RULER haystack/QA source data: large, and reproducible from the vendored
# download scripts. The generators and configs ARE tracked; these are not.
benchmarks/ruler_official/data/synthetic/json/PaulGrahamEssays.json
benchmarks/ruler_official/data/synthetic/json/squad.json
benchmarks/ruler_official/data/synthetic/json/hotpotqa.json

# Generated RULER inputs: 143 MB, and exactly reproducible from the vendored
# generators (fixed --random_seed 42, pinned tokenizer per model) via
#   benchmarks/generate_ruler_data.sh
# The PREDICTIONS and scores under paper/results/ruler/ are tracked; the inputs
# they were produced from are regenerated, not stored.
paper/results/ruler_data/

# `LongBench/` at line 61 was meant for a vendored checkout of the benchmark
# repo. On Windows core.ignorecase makes it match paper/results/longbench as
# well, and git will NOT re-include a file whose parent DIRECTORY is excluded --
# so the *.jsonl negations above silently did nothing for that folder and every
# LongBench result was untracked. Un-exclude the directory itself.
!paper/results/longbench/

# Same trap as LongBench/ above: `RULER/` at line 62 was meant for a vendored
# checkout of the benchmark repo, and core.ignorecase makes it swallow
# paper/results/ruler. Git will not re-include a file whose parent DIRECTORY is
# excluded, so the *.jsonl negations did nothing here either.
!paper/results/ruler/

# Fidelity logs are the KL-vs-dense evidence behind the correctness claims.
!paper/results/fidelity_q4/
!paper/results/**/*.log
