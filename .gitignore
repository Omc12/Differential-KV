# Byte-compiled / optimized / DLL files
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Unit test / coverage reports
.pytest_cache/
.tox/
.coverage
.coverage.*
.cache
*.log

# Telemetry and PyTorch Profiler trace files (huge JSONs)
*profiler_trace.json
*.pt.trace.json
*raw_telemetry.json
*raw_nvidia_smi*.log
*.jsonl
*.pt
*.pth
*.bin
*.safetensors

# Exclude all JSON trace/profiler files in any archive, telemetry, or results folder
**/archive/**/*.json
**/telemetry/**/*.json
**/results/**/*.json

# Ignore the massive synthetic systems archive completely
archive/ARCHIVED_SYNTHETIC_SYSTEMS/

# Build directories
**/build/
build/

# Compiled native extensions & object files — build per-platform, never commit.
# NOTE: .gitignore does not untrack files already in the index. Some artifacts
# (diffkv_core.cpython-*-darwin.so, build/*.o) were committed before these rules;
# see BUILD.md → "Untracking committed build artifacts" for the one-time cleanup.
*.so
*.dylib
*.o
*.obj

# GGUF models
*.gguf
**/qwen2.5-0.5b-instruct.gguf
